# Polymarket MCP Server Configuration
# Copy this file to .env and fill in your values

# ============================================================================
# DEMO MODE - Run without real wallet credentials (read-only)
# ============================================================================
# Set to true for read-only access without needing a wallet
# Perfect for testing market discovery, analysis, and monitoring features
# Trading functions will be disabled in DEMO mode
#
# When DEMO_MODE=true, you don't need to provide:
#   - POLYGON_PRIVATE_KEY
#   - POLYGON_ADDRESS
#
# The system will use safe demo values automatically.
DEMO_MODE=false

# ============================================================================
# Polygon Wallet Configuration (REQUIRED unless DEMO_MODE=true)
# ============================================================================

# Your Polygon wallet private key (without 0x prefix)
# Get from: MetaMask > Settings > Security > Export Private Key
# IMPORTANT: Keep this secret! Never commit to git or share publicly
POLYGON_PRIVATE_KEY=your_private_key_here

# Your Polygon wallet address (with 0x prefix)
# Get from: Your wallet's public address
POLYGON_ADDRESS=0xYourAddressHere

# Polygon chain ID (137 for mainnet, 80002 for Amoy testnet)
POLYMARKET_CHAIN_ID=137

# Environment switch (recommended)
# - mainnet: chain 137, CLOB https://clob.polymarket.com, Gamma https://gamma-api.polymarket.com
# - testnet: chain 80002, CLOB https://clob-testnet.polytest.cloud, Gamma https://gcomm-api.polytest.cloud
#
# If set, the server auto-fills chain/endpoints unless you explicitly override
# POLYMARKET_CHAIN_ID, CLOB_API_URL, or GAMMA_API_URL below.
POLYMARKET_ENV=mainnet

# Required geoblock endpoint used at startup to verify the server IP is allowed.
# This endpoint is on polymarket.com (not on the CLOB or Gamma API hosts).
POLYMARKET_GEOBLOCK_URL=https://polymarket.com/api/geoblock

# ============================================================================
# Polymarket CLOB Login Credentials (Two-Layer bootstrap)
# ============================================================================

# L2/CLOB key triplet for authenticated requests ("login" to CLOB/relayer).
# Preferred variable names (values copied from Polymarket UI Settings -> API):
#
# IMPORTANT:
# - POLYMARKET_RELAYER_KEY (UUID / API Key ID) is mandatory for L2 bootstrap.
# - If SECRET + PASSPHRASE are provided, server uses static credentials as-is.
# - If SECRET and/or PASSPHRASE are empty, server derives them at runtime from
#   POLYGON_PRIVATE_KEY (wallet signature).
POLYMARKET_RELAYER_KEY=your_relayer_uuid_here
POLYMARKET_RELAYER_SECRET=
POLYMARKET_RELAYER_PASSPHRASE=

# Backward-compatible aliases for the same CLOB credentials.
# Leave empty to auto-generate on first run.
# Or get from: https://polymarket.com/settings/api
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_PASSPHRASE=
POLYMARKET_API_KEY_NAME=

# Wallet auth mode for the Polymarket SDK.
# Supported values:
# - 0 = EOA direct mode (funder is forced to POLYGON_ADDRESS)
# - 3 = MetaMask deposit-wallet flow (POLY_1271)
POLYMARKET_SIGNATURE_TYPE=3

# Funding/deposit wallet shown in the Polymarket UI.
# Set this when the wallet that holds funds/positions is different from the
# signer EOA exported from MetaMask. If empty, defaults to POLYGON_ADDRESS.
POLYMARKET_FUNDER=

# ============================================================================
# Safety Limits - Risk Management
# ============================================================================

# Maximum size for a single order in USD
MAX_ORDER_SIZE_USD=1000

# Maximum total exposure across all positions in USD
MAX_TOTAL_EXPOSURE_USD=5000

# Maximum position size per market in USD
MAX_POSITION_SIZE_PER_MARKET=2000

# Minimum liquidity required in market before trading (USD)
MIN_LIQUIDITY_REQUIRED=10000

# Maximum spread tolerance (0.05 = 5%)
MAX_SPREAD_TOLERANCE=0.05

# ============================================================================
# Trading Controls
# ============================================================================

# Enable autonomous trading without confirmation
# WARNING: Use with caution! Set to false for manual approval
ENABLE_AUTONOMOUS_TRADING=true

# Require user confirmation for orders above this USD amount
REQUIRE_CONFIRMATION_ABOVE_USD=500

# Automatically cancel orders if spread exceeds MAX_SPREAD_TOLERANCE
AUTO_CANCEL_ON_LARGE_SPREAD=true

# ============================================================================
# API Endpoints (OPTIONAL explicit overrides except geoblock)
# ============================================================================

# Polymarket CLOB API endpoint (optional explicit override)
CLOB_API_URL=https://clob.polymarket.com

# Gamma API endpoint for market data (optional explicit override)
GAMMA_API_URL=https://gamma-api.polymarket.com

# ============================================================================
# WebSocket Realtime
# ============================================================================

# Enable/disable realtime WebSocket features and background connection startup
WS_ENABLED=true

# ============================================================================
# Logging
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ============================================================================
# MCP Transport
# ============================================================================

# Transport mode: streamable-http (default) or stdio (Claude Desktop local mode)
MCP_TRANSPORT=streamable-http

# Streamable HTTP settings (used when MCP_TRANSPORT=streamable-http)
MCP_STREAMABLE_HTTP_HOST=0.0.0.0
MCP_STREAMABLE_HTTP_PORT=8000
MCP_STREAMABLE_HTTP_PATH=/mcp

# ============================================================================
# Caching (OPTIONAL)
# ============================================================================

# Redis connection URL for optional Redis-backed caching.
# When set, portfolio data (positions, etc.) is cached in Redis instead of
# the default in-process memory cache, allowing cache sharing across workers
# and persistence across process restarts.
#
# Requires the 'redis' optional dependency:
#   pip install 'polymarket-mcp[redis]'
#
# If REDIS_URL is unset (or Redis is unreachable) the server automatically
# falls back to the built-in in-memory cache — no action required.
#
# Examples:
#   REDIS_URL=redis://localhost:6379/0
#   REDIS_URL=redis://:password@redis-host:6379/0
#   REDIS_URL=rediss://redis-host:6380/0   (TLS)
#   REDIS_HOST=redis
#   REDIS_PORT=6379
REDIS_URL=
REDIS_HOST=
REDIS_PORT=

# ============================================================================
# Advanced Configuration (typically no changes needed)
# ============================================================================

# USDC token address on Polygon
USDC_ADDRESS=0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174

# CTF Exchange contract address
CTF_EXCHANGE_ADDRESS=0x4bFb41d5B3570DeFd03C39a9A4D8dE6Bd8B8982E

# Conditional Token contract address
CONDITIONAL_TOKEN_ADDRESS=0x4D97DCd97eC945f40cF65F87097ACe5EA0476045
